+def _stored_session_model_config(session_db, session_key: str) -> dict:
+    """A session row's ``model_config`` as a dict (per-chat pins live there)."""
+    if not session_key or session_db is None:
+        return {}
+
+    try:
+        row = session_db.get_session(session_key) or {}
+    except Exception:
+        return {}
+
+    raw_config = row.get("model_config") if isinstance(row, dict) else None
+    if isinstance(raw_config, dict):
+        return raw_config
+    if isinstance(raw_config, str) and raw_config.strip():
+        try:
+            parsed = json.loads(raw_config)
+        except Exception:
+            return {}
+        return parsed if isinstance(parsed, dict) else {}
+
+    return {}
+
