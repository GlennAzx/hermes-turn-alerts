--- a/hermes_cli/lifecycle.py
+++ b/hermes_cli/lifecycle.py
@@ -19,6 +19,25 @@ def invoke_hook(hook_name: str, **kwargs: Any) -> List[Any]:
 
     from hermes_cli import plugins
 
+    # Shell hooks live in the manager's hook table, and that table belongs to
+    # ONE manager per resolved home. A turn can run under a different profile
+    # scope than the one that registered them, and discovery rebuilds the table
+    # outright, so a config-owned hook can be missing exactly when its event
+    # fires. Re-registering here is cheap (config is cached) and idempotent;
+    # without it `hooks:` entries in config.yaml are silently dead on the
+    # desktop/TUI backend.
+    if hook_name == "on_session_end":
+        try:
+            # register_from_config() is idempotent against the manager's OWN
+            # table, so this repairs a wiped table without stacking a duplicate
+            # callback on every turn.
+            from agent.shell_hooks import register_from_config
+            from hermes_cli.config import load_config
+
+            register_from_config(load_config())
+        except Exception:
+            logger.debug("shell-hook re-registration before on_session_end failed", exc_info=True)
+
     return plugins.invoke_hook(hook_name, **kwargs)
 
 
